{
  "name": "exception-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Shipping exception desk built with the OpenAI Agents SDK for TypeScript",
  "engines": { "node": ">=20" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "demo": "tsx src/main.ts",
    "serve": "tsx src/server.ts",
    "test": "vitest run",
    "test:offline": "vitest run evals/offline.test.ts",
    "test:evals": "vitest run evals/routing.test.ts",
    "ex:1": "tsx examples/01-single-agent.ts",
    "ex:2": "tsx examples/02-tools.ts",
    "ex:3": "tsx examples/03-handoffs.ts",
    "ex:4": "tsx examples/04-agents-as-tools.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/agents": "0.21.0",
    "dotenv": "^17.0.0",
    "express": "^5.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
