# Required for everything except `npm run test:offline`
OPENAI_API_KEY=sk-...

# fixture = local fake Shippo/Gmail MCP servers (default, safe, free)
# live    = real Shippo + Gmail MCP servers (needs tokens below)
MCP_MODE=fixture

# Optional: use a smaller/cheaper model for the injection screen and option agents
SMALL_MODEL=gpt-5-mini
MAIN_MODEL=gpt-5

# Optional: use OpenAI-hosted file search instead of the local policy search tool
# VECTOR_STORE_ID=vs_...

# Live mode only
# SHIPPO_MCP_URL=https://mcp.shippo.com
# SHIPPO_MCP_TOKEN=...
# GMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# GMAIL_MCP_TOKEN=...

# Policy: ask a human above this reship/refund amount (USD)
APPROVAL_LIMIT_USD=50
